eight:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753315691602_588450710","id":"paragraph_1753315691602_588450710","dateCreated":"2025-07-24T00:08:11+0000","dateStarted":"2025-07-24T00:20:38+0000","dateFinished":"2025-07-24T00:20:38+0000","status":"FINISHED"},{"text":"val cuartiles = dfNacidosClean.stat.approxQuantile(\"anio_nac\", Array(0.25, 0.75), 0.01)\nval q1 = cuartiles(0)\nval q3 = cuartiles(1)\nval iqr = q3 - q1\n\nval limiteInferior = q1 - 1.5 * iqr\nval limiteSuperior = q3 + 1.5 * iqr","user":"anonymous","dateUpdated":"2025-07-24T00:53:29+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mcuartiles\u001b[0m: \u001b[1m\u001b[32mArray[Double]\u001b[0m = Array(2023.0, 2023.0)\n\u001b[1m\u001b[34mq1\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2023.0\n\u001b[1m\u001b[34mq3\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2023.0\n\u001b[1m\u001b[34miqr\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 0.0\n\u001b[1m\u001b[34mlimiteInferior\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2023.0\n\u001b[1m\u001b[34mlimiteSuperior\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2023.0\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=298"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753316082941_424083108","id":"paragraph_1753316082941_424083108","dateCreated":"2025-07-24T00:14:42+0000","dateStarted":"2025-07-24T00:53:29+