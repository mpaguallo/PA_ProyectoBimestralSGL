raph_1752767941711_657156875","dateCreated":"2025-07-17T15:59:01+0000","dateStarted":"2025-07-24T08:24:56+0000","dateFinished":"2025-07-24T08:24:57+0000","status":"FINISHED"},{"text":"val cuartiles = dfNacidosCleanFinal.stat.approxQuantile(\r\n    \"peso\", Array(0.25, 0.75), 0.01\r\n    \r\n)","user":"anonymous","dateUpdated":"2025-07-24T08:24:58+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mcuartiles\u001b[0m: \u001b[1m\u001b[32mArray[Double]\u001b[0m = Array(2800.0, 3385.0)\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=87"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752767951644_1794946097","id":"paragraph_1752767951644_1794946097","dateCreated":"2025-07-17T15:59:11+0000","dateStarted":"2025-07-24T08:24:58+0000","dateFinished":"2025-07-24T08:24:59+0000","status":"FINISHED"},{"text":"val q1 = cuartiles(0)\r\nval q3 = cuartiles(1)\r\nval iqr = q3 - q1","user":"anonymous","dateUpdated":"2025-07-24T08:24:59+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mq1\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2800.0\n\u001b[1m\u001b[34mq3\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 3385.0\n\u001b[1m\u001b[34miqr\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 585.0\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752767949669_1203920733","id":"paragraph_1752767949669_1203920733","dateCreated":"2025-07-17T15:59:09+0000","dateStarted":"2025-07-24T08:24:59+0000","dateFinished":"2025-07-24T08:24:59+0000","status":"FINISHED"},{"text":"val limiteInferiorIQR = q1 - 1.5 * iqr\r\nval limiteSuperiorIQR = q1 + 1.5 * iqr","user":"anonymous","dateUpdated":"2025-07-24T08:25:00+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mlimiteInferiorIQR\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 1922.5\n\u001b[1m\u001b[34mlimiteSuperiorIQR\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 3677.5\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752767974029_1739590618","id":"paragraph_1752767974029_1739590618","dateCreated":"2025-07-17T15:59:34+0000","dateStarted":"2025-07-24T08:25:00+0000","dateFinished":"2025-07-24T08:25:00+0000","status":"FINISHED"},{"text":"val outliersIQR = dfNacidosCleanFinal\r\n    .where($\"peso\" < limiteInferiorIQR || $\"peso\" > limiteSuperiorIQR)","user":"anonymous","dateUpdated":"2025-07-24T08:25:00+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34moutliersIQR\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_insc: string, cant_insc: string ... 48 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752767984958_1180829755","id":"paragraph_1752767984958_1180829755","dateCreated":"2025-07-17T15:59:44+0000","dateStarted":"2025-07-24T08:25:00+0000","dateFinished":"2025