":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=90"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752768021127_806218071","id":"paragraph_1752768021127_806218071","dateCreated":"2025-07-17T16:00:21+0000","dateStarted":"2025-07-24T08:25:02+0000","dateFinished":"2025-07-24T08:25:06+0000","status":"FINISHED"},{"text":"%pyspark\n\nplt.figure(figsize = (20, 10))\nplt.boxplot(df_nacidos_anio_nac['peso'],showfliers=True)\nplt.title('Boxplot de peso para Deteccion de Outliers')\nplt.ylabel('peso')\nplt.grid(True, linestyle='--', alpha = 0.7)\nplt.show()\n","user":"anonymous","dateUpdated":"2025-07-24T08:25:06+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752768030912_91370384","id":"paragraph_1752768030912_91370384","dateCreated":"2025-07-17T16:00:30+0000","dateStarted":"2025-07-24T08:25:07+0000","dateFinished":"2025-07-24T08:25:07+0000","status":"FINISHED"},{"text":"%md\n# 1. ¿Cómo varía el tipo de parto (tipo_part) según la edad de la madre (edad_mad), y hay alguna tendencia clara en el uso de cesáreas en diferentes grupos de edad?\n\n### > Detectar si las madres jóvenes o mayores tienen más probabilidad de tener partos por cesárea.","user":"anonymous","dateUpdated":"2025-07-24T08:25:07+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>1. ¿Cómo varía el tipo de parto (tipo_part) según la edad de la madre (edad_mad), y hay alguna tendencia clara en el uso de cesáreas en diferentes grupos de edad?</h1>\n<h3>&gt; Detectar si las madres jóvenes o mayores tienen más probabilidad de tener partos por cesárea.</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752768073061_644919892","id":"paragraph_1752768073061_644919892","dateCreated":"2025-07-17T16:01:13+0000","dateStarted":"2025-07-24T08:25:07+0000","dateFinished":"2025-07-24T08:25:07+0000","status":"FINISHED"},{"text":"z.show {\r\n  dfPartoNum\r\n    .withColumn(\"edad_mad_int\", $\"edad_mad\".cast(\"int\"))\r\n    .withColumn(\"grupo_edad\",\r\n      when($\"edad_mad_int\".between(10, 19), \"10-19\")\r\n      .when($\"edad_mad_int\".between(20, 24), \"20-24\")\r\n      .when($\"edad_mad_int\".between(25, 29), \"25-29\")\r\n      .when($\"edad_mad_int\".between(30, 34), \"30-34\")\r\n      .when($\"edad_mad_int\".between(35, 39), \"35-39\")\r\n      .when($\"edad_mad_int\".between(40, 44), \"40-44\")\r\n      .when($\"edad_mad_int\".between(45, 49), \"45-49\")\r\n      .otherwise(\"50+\")\r\n    )\r\n    .groupBy(\"grupo_edad\", \"tipo_part\")\r\n    .count()\r\n    //.orderBy(\"grupo_edad\", desc(\"count\"))\r\n}\r\n\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:25:25+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"grupo_edad","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"tipo_part","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"ERROR","msg":[{"type":"TEXT","data":"<console>:47: \u001b[31merror: \u001b[0mnot found: value dfPartoNum\n         dfPartoNum\n         ^\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753310504925_1677673038","id":"paragraph_1753310504925_1677673038","dateCreated":"2025-07-23T22:41:44+0000","dateStarted":"2025-07-24T08:25:25+0000","dateFinished":"2025-07-24T08:25:25+0000","status":"ERROR","focus":false},{"text":"%md\r\n# 2. *¿Cuál es la proporción de nacimientos inscritos en el mismo lugar de ocurrencia versus en otra provincia/cantón?*\r\n\r\n###    > Se puede comparar prov_insc vs prov_nac.","user":"anonymous","dateUpdated":"2025-07-23T04:04:21+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>2. <em>¿Cuál es la proporción de nacimientos inscritos en el mismo lugar de ocurrencia versus en otra provincia/cantón?</em></h1>\n<h3>&gt; Se puede comparar prov_insc vs prov_nac.</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752980662334_1607417621","id":"paragraph_1752980662334_1607417621","dateCreated":"2025-07-20T03:04:22+0000","dateStarted":"2025-07-23T04:04:21+0000","dateFinished":"2025-07-23T04:04:21+0000","status":"FINISHED"},{"text":"val dfValidos = dfNacidosCleanFinal\n  .filter(col(\"prov_insc\").isNotNull && col(\"prov_nac\").isNotNull)\n","user":"anonymous","dateUpdated":"2025-07-24T08:26:03+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfValidos\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_insc: string, cant_insc: string ... 48 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752981062575_116728018","id":"paragraph_1752981062575_116728018","dateCreated":"2025-07-20T03:11:02+0000","dateStarted":"2025-07-24T08:26:03+0000","dateFinished":"2025-07-24T08:26:03+0000","status":"FINISHED","focus":false},{"text":"import org.apache.spark.sql.functions._\r\n\r\nval dfComparacion = dfValidos.withColumn(\r\n  \"tipo_inscripcion\",\r\n  when(col(\"prov_insc\") === col(\"prov_nac\"), \"Mismo lugar\")\r\n    .otherwise(\"Otra provincia\")\r\n)\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:26:06+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfComparacion\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_insc: string, cant_insc: string ... 49 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752982035243_1530335862","id":"paragraph_1752982035243_1530335862","dateCreated":"2025-07-20T03:27:15+0000","dateStarted":"2025-07-24T08:26:06+0000","dateFinished":"2025-07-24T08:26:07+0000","status":"FINISHED","focus":false},{"text":"val resultado = dfComparacion\r\n  .groupBy(\"tipo_inscripcion\")\r\n  .count()\r\n  .orderBy(desc(\"count\"))\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:26:12+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mresultado\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [tipo_inscripcion: string, count: bigint]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752982065549_1757561064","id":"paragraph_1752982065549_1757561064","dateCreated":"2025-07-20T03:27:45+0000","dateStarted":"2025-07-24T08:26:12+0000","dateFinished":"2025-07-24T08:26:12+0000","status":"FINISHED","focus":false},{"text":"z.show {\r\n  dfComparacion\r\n  .groupBy(\"tipo_inscripcion\")\r\n  .count()\r\n  .orderBy(desc(\"count\"))\r\n}","user":"anonymous","dateUpdated":"2025-07-24T08:26:14+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"tipo_inscripcion","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"tipo_inscripcion\tcount\nMismo lugar\t218872\nOtra provincia\t22423\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=91"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=92"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752982078614_578069269","id":"paragraph_1752982078614_578069269","dateCreated":"2025-07-20T03:27:58+0000","dateStarted":"2025-07-24T08:26:14+0000","dateFinished":"2025-07-24T08:26:15+0000","status":"FINISHED","focus":false},{"text":"%md\r\n# 3. *¿Cuántos nacimientos fueron registrados en una fecha muy posterior al nacimiento (ej. diferencia entre fecha_insc y fecha_nac > 30 días)?*\r\n\r\n###      > Esto permite detectar retrasos en el registro civil.","user":"anonymous","dateUpdated":"2025-07-23T04:04:23+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>3. <em>¿Cuántos nacimientos fueron registrados en una fecha muy posterior al nacimiento (ej. diferencia entre fecha_insc y fecha_nac &gt; 30 días)?</em></h1>\n<h3>&gt; Esto permite detectar retrasos en el registro civil.</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752982138149_1792673752","id":"paragraph_1752982138149_1792673752","dateCreated":"2025-07-20T03:28:58+0000","dateStarted":"2025-07-23T04:04:23+0000","dateFinished":"2025-07-23T04:04:23+0000","status":"FINISHED"},{"text":"val dfFechas = dfNacidosCleanFinal\n  .filter(col(\"fecha_insc\").isNotNull && col(\"fecha_nac\").isNotNull)\n  .withColumn(\"fecha_insc_dt\", to_date(col(\"fecha_insc\"), \"yyyy-MM-dd\"))\n  .withColumn(\"fecha_nac_dt\", to_date(col(\"fecha_nac\"), \"yyyy-MM-dd\"))\n","user":"anonymous","dateUpdated":"2025-07-24T08:27:51+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfFechas\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_insc: string, cant_insc: string ... 50 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753031106959_1451660644","id":"paragraph_1753031106959_1451660644","dateCreated":"2025-07-20T17:05:06+0000","dateStarted":"2025-07-24T08:27:51+0000","dateFinished":"2025-07-24T08:27:51+0000","status":"FINISHED","focus":false},{"text":"import org.apache.spark.sql.functions._\n\nval dfFechas = dfNacidosCleanFinal\n  .filter(col(\"fecha_insc\").isNotNull && col(\"fecha_nac\").isNotNull)\n  .withColumn(\"anio_nac\", year(col(\"fecha_nac\")))\n  .withColumn(\"mes_nac\", month(col(\"fecha_nac\")))\n  .withColumn(\"dia_nac\", dayofmonth(col(\"fecha_nac\")))\n  .withColumn(\"anio_insc\", year(col(\"fecha_insc\")))\n  .withColumn(\"mes_insc\", month(col(\"fecha_insc\")))\n  .withColumn(\"dia_insc\", dayofmonth(col(\"fecha_insc\")))\n","user":"anonymous","dateUpdated":"2025-07-24T08:27:52+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"editorHide":false,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfFechas\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_insc: string, cant_insc: string ... 48 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752982875597_641346214","id":"paragraph_1752982875597_641346214","dateCreated":"2025-07-20T03:41:15+0000","dateStarted":"2025-07-24T08:27:52+0000","dateFinished":"2025-07-24T08:27:53+0000","status":"FINISHED","focus":false},{"text":"dfFechas.printSchema()","user":"anonymous","dateUpdated":"2025-07-23T04:04:23+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"root\n |-- prov_insc: string (nullable = true)\n |-- cant_insc: string (nullable = true)\n |-- parr_insc: string (nullable = true)\n |-- fecha_insc: string (nullable = true)\n |-- anio_insc: integer (nullable = true)\n |-- mes_insc: integer (nullable = true)\n |-- dia_insc: integer (nullable = true)\n |-- sexo: string (nullable = true)\n |-- fecha_nac: string (nullable = true)\n |-- anio_nac: integer (nullable = true)\n |-- mes_nac: integer (nullable = true)\n |-- dia_nac: integer (nullable = true)\n |-- talla: integer (nullable = true)\n |-- peso: integer (nullable = true)\n |-- sem_gest: integer (nullable = true)\n |-- tipo_part: string (nullable = true)\n |-- lugar_ocur: string (nullable = true)\n |-- apgar1: integer (nullable = true)\n |-- apgar5: integer (nullable = true)\n |-- p_emb: string (nullable = true)\n |-- prov_nac: string (nullable = true)\n |-- cant_nac: string (nullable = true)\n |-- parr_nac: string (nullable = true)\n |-- area_nac: string (nullable = true)\n |-- asis_por: string (nullable = true)\n |-- nac_mad: string (nullable = true)\n |-- cod_pais: string (nullable = true)\n |-- fecha_mad: string (nullable = true)\n |-- anio_mad: integer (nullable = true)\n |-- mes_mad: string (nullable = true)\n |-- dia_mad: integer (nullable = true)\n |-- edad_mad: integer (nullable = true)\n |-- con_pren: integer (nullable = true)\n |-- num_emb: integer (nullable = true)\n |-- num_par: integer (nullable = true)\n |-- hij_viv: integer (nullable = true)\n |-- hij_vivm: integer (nullable = true)\n |-- hij_nacm: integer (nullable = true)\n |-- etnia: string (nullable = true)\n |-- est_civil: string (nullable = true)\n |-- niv_inst: string (nullable = true)\n |-- sabe_leer: string (nullable = true)\n |-- prov_res: string (nullable = true)\n |-- cant_res: string (nullable = true)\n |-- parr_res: string (nullable = true)\n |-- area_res: string (nullable = true)\n |-- residente: string (nullable = true)\n |-- fecha_insc_date: date (nullable = true)\n |-- fecha_nac_date: date (nullable = true)\n |-- fecha_mad_date: date (nullable = true)\n\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753031183233_1414801133","id":"paragraph_1753031183233_1414801133","dateCreated":"2025-07-20T17:06:23+0000","dateStarted":"2025-07-23T04:04:23+0000","dateFinished":"2025-07-23T04:04:23+0000","status":"FINISHED"},{"text":"val dfDiferenciaDias = dfFechas.withColumn(\r\n  \"dias_nacimiento\",\r\n  (col(\"anio_nac\") * 365) + (col(\"mes_nac\") * 30) + col(\"dia_nac\")\r\n).withColumn(\r\n  \"dias_inscripcion\",\r\n  (col(\"anio_insc\") * 365) + (col(\"mes_insc\") * 30) + col(\"dia_insc\")\r\n).withColumn(\r\n  \"dias_diferencia\",\r\n  col(\"dias_inscripcion\") - col(\"dias_nacimiento\")\r\n)\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:27:57+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfDiferenciaDias\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_insc: string, cant_insc: string ... 51 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753030465812_1576933710","id":"paragraph_1753030465812_1576933710","dateCreated":"2025-07-20T16:54:25+0000","dateStarted":"2025-07-24T08:27:57+0000","dateFinished":"2025-07-24T08:27:57+0000","status":"FINISHED","focus":false},{"text":"import org.apache.spark.sql.functions._\r\n\r\nval dfRetrasos = dfFechas\r\n  .withColumn(\"dias_diferencia\", datediff(\r\n      to_date(col(\"fecha_insc\"), \"yyyy-MM-dd\"),\r\n      to_date(col(\"fecha_nac\"), \"yyyy-MM-dd\")\r\n  ))\r\n  .filter(col(\"dias_diferencia\") > 30)\r\n\r\n// Mostrar el conteo de registros con retrasos mayores a 30 días\r\nval cantidadRetrasos = dfRetrasos.count()\r\n\r\nprintln(s\"Nacimientos registrados con más de 30 días de retraso: $cantidadRetrasos\")\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:27:59+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Nacimientos registrados con más de 30 días de retraso: 0\nimport org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfRetrasos\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_insc: string, cant_insc: string ... 49 more fields]\n\u001b[1m\u001b[34mcantidadRetrasos\u001b[0m: \u001b[1m\u001b[32mLong\u001b[0m = 0\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=93"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=94"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753157312553_794620559","id":"paragraph_1753157312553_794620559","dateCreated":"2025-07-22T04:08:32+0000","dateStarted":"2025-07-24T08:27:59+0000","dateFinished":"2025-07-24T08:28:02+0000","status":"FINISHED","focus":false},{"text":"z.show {\r\n  dfConEtiqueta\r\n    .groupBy(\"tipo_registro\")\r\n    .count()\r\n    .orderBy(desc(\"count\"))\r\n}\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:28:04+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"