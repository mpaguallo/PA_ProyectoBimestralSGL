9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>7.¿En qué lugares ocurren más nacimientos? (hospital, domicilio, otros) según la variable lugar_ocur, y cómo varía por zona (area_res)?</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753201556497_2023693026","id":"paragraph_1753201556497_2023693026","dateCreated":"2025-07-22T16:25:56+0000","dateStarted":"2025-07-22T16:26:16+0000","dateFinished":"2025-07-22T16:26:16+0000","status":"FINISHED"},{"text":"// Distribución de Lugares de Ocurrencia de Nacimientos (lugar_ocur) con datos limpios\nz.show(\n    dfNacidosCleanFinal\n        .filter(col(\"lugar_ocur\").isNotNull && col(\"lugar_ocur\") =!= \"Sin información\" && col(\"lugar_ocur\") =!= \"\" && col(\"lugar_ocur\") =!= \"Otro\")\n        .select(\"lugar_ocur\")\n        .groupBy(\"lugar_ocur\")\n        .count()\n        .orderBy(col(\"count\").desc)\n)\n\n// Distribución de Lugares de Ocurrencia de Nacimientos (lugar_ocur) por Área de Residencia (area_res) con datos limpios\nz.show(\n    dfNacidosCleanFinal\n        .filter(col(\"area_res\").isNotNull && col(\"area_res\") =!= \"Sin información\" && col(\"area_res\") =!= \"\" && col(\"area_res\") =!= \"Otro\" &&\n                col(\"lugar_ocur\").isNotNull && col(\"lugar_ocur\") =!= \"Sin información\" && col(\"lugar_ocur\") =!= \"\" && col(\"lugar_ocur\") =!= \"Otro\")\n        .groupBy(\"area_res\", \"lugar_ocur\")\n        .count()\n        //.orderBy(\"area_res\", col(\"count\").desc)\n)","user":"anonymous","dateUpdated":"2025-07-24T08:30:35+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"lugar_ocur","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}},"1":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"scatterChart":{}},"keys":[{"name":"area_res","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"lugar_ocur","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"lugar_ocur\tcount\nEstablecimiento del Ministerio de Salud\t150612\nHospital, Clínica o Consultorio Privado\t58912\nEstablecimiento del IESS\t19591\nCasa\t2452\nOtro Establecimiento Público\t1644\nEstablecimiento de la Junta de Beneficencia\t1014\n"},{"type":"TABLE","data":"area_res\tlugar_ocur\tcount\nUrbana\tEstablecimiento de la Junta de Beneficencia\t981\nUrbana\tEstablecimiento del IESS\t14590\nRural\tCasa\t1403\nUrbana\tOtro Establecimiento Público\t1234\nRural\tOtro Establecimiento Público\t410\nRural\tEstablecimiento de la Junta de Beneficencia\t33\nUrbana\tEstablecimiento del Ministerio de Salud\t112438\nRural\tEstablecimiento del Ministerio de Salud\t38174\nUrbana\tHospital, Clínica o Consultorio Privado\t47501\nUrbana\tCasa\t1049\nRural\tHospital, Clínica o Consultorio Privado\t11411\nRural\tEstablecimiento del IESS\t5001\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=20"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=21"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=22"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=23"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753242646028_804804361","id":"paragraph_1753242646028_804804361","dateCreated":"2025-07-23T03:50:46+0000","dateStarted":"2025-07-23T03:54:22+0000","dateFinished":"2025-07-23T03:54:24+0000","status":"FINISHED"},{"text":"%md\r\n### 8.¿Qué proporción de nacimientos corresponde a madres extranjeras (cod_pais distinto de \"ECU\") y dónde residen principalmente? ","user":"anonymous","dateUpdated":"2025-07-22T16:26:42+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>8.¿Qué proporción de nacimientos corresponde a madres extranjeras (cod_pais distinto de &ldquo;ECU&rdquo;) y dónde residen principalmente?</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753201586054_1359395483","id":"paragraph_1753201586054_1359395483","dateCreated":"2025-07-22T16:26:26+0000","dateStarted":"2025-07-22T16:26:42+0000","dateFinished":"2025-07-22T16:26:42+0000","status":"FINISHED"},{"text":"// Top 10 Provincias de Residencia de Madres Extranjeras (con filtrado de datos no deseados)\nz.show(\n    dfNacidosCleanFinal\n        .filter(col(\"cod_pais\").isNotNull && col(\"cod_pais\") =!= \"Sin información\" && col(\"cod_pais\") =!= \"\" && col(\"cod_pais\") =!= \"ECU\" &&\n                col(\"prov_res\").isNotNull && col(\"prov_res\") =!= \"Sin información\" && col(\"prov_res\") =!= \"\")\n        .select(\"prov_res\")\n        .groupBy(\"prov_res\")\n        .count()\n        .orderBy(col(\"count\").desc)\n        .limit(10)\n)\n\n// Distribución de Área de Residencia de Madres Extranjeras (con filtrado de datos no deseados)\nz.show(\n    dfNacidosCleanFinal\n        .filter(col(\"cod_pais\").isNotNull && col(\"cod_pais\") =!= \"Sin información\" && col(\"cod_pais\") =!= \"\" && col(\"cod_pais\") =!= \"ECU\" &&\n                col(\"area_res\").isNotNull && col(\"area_res\") =!= \"Sin información\" && col(\"area_res\") =!= \"\")\n        .select(\"area_res\")\n        .groupBy(\"area_res\")\n        .count()\n        .orderBy(col(\"count\").desc)\n)","user":"anonymous","dateUpdated":"2025-07-23T22:12:36+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"prov_res","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}},"1":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{},"keys":[{"name":"area_res","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"prov_res\tcount\nGuayas\t62640\nPichincha\t34259\nManabí\t24423\nLos Ríos\t15233\nEsmeraldas\t11324\nEl Oro\t9982\nAzuay\t9645\nSanto Domingo de los Tsáchilas\t8430\nTungurahua\t6855\nSanta Elena\t6547\n"},{"type":"TABLE","data":"area_res\tcount\nUrbana\t181232\nRural\t60063\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=46"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=47"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=48"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=49"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753201602209_730872878","id":"paragraph_1753201602209_730872878","dateCreated":"2025-07-22T16:26:42+0000","dateStarted":"2025-07-23T04:01:57+0000","dateFinished":"2025-07-23T04:02:00+0000","status":"FINISHED"},{"text":"%md\r\n### 9.¿Cuántos nacimientos corresponden a personas no residentes (residente = 'No Residente') y en qué zonas se concentran? ","user":"anonymous","dateUpdated":"2025-07-22T16:27:16+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>9.¿Cuántos nacimientos corresponden a personas no residentes (residente = &lsquo;No Residente&rsquo;) y en qué zonas se concentran?</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753201616218_2045909037","id":"paragraph_1753201616218_2045909037","dateCreated":"2025-07-22T16:26:56+0000","dateStarted":"2025-07-22T16:27:16+0000","dateFinished":"2025-07-22T16:27:16+0000","status":"FINISHED"},{"text":"val noResidentesDF = dfNacidosCleanFinal.filter(col(\"residente\") === \"No Residente\")\nval totalNacimientosNoResidentes = noResidentesDF.count()\nprintln(s\"Total Nacimientos de Madres No Residentes: $totalNacimientosNoResidentes\")\n\n// Top 10 Provincias de Residencia de Madres No Residentes (con filtrado de datos no deseados)\nif (totalNacimientosNoResidentes > 0) {\n    z.show(\n        dfNacidosCleanFinal\n            .filter(col(\"residente\").isNotNull && col(\"residente\") =!= \"Sin información\" && col(\"residente\") =!= \"\" && col(\"residente\") === \"No Residente\" &&\n                    col(\"prov_res\").isNotNull && col(\"prov_res\") =!= \"Sin información\" && col(\"prov_res\") =!= \"\")\n            .select(\"prov_res\")\n            .groupBy(\"prov_res\")\n            .count()\n            .orderBy(col(\"count\").desc)\n            .limit(10)\n    )\n\n}","user":"anonymous","dateUpdated":"2025-07-24T08:31:36+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Total Nacimientos de Madres No Residentes: 0\n\u001b[1m\u001b[34mnoResidentesDF\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_insc: string, cant_insc: string ... 48 more fields]\n\u001b[1m\u001b[34mtotalNacimientosNoResidentes\u001b[0m: \u001b[1m\u001b[32mLong\u001b[0m = 0\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=103"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=104"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753201636585_1626629652","id":"paragraph_1753201636585_1626629652","dateCreated":"2025-07-22T16:27:16+0000","dateStarted":"2025-07-24T08:31:36+0000","dateFinished":"2025-07-24T08:31:37+0000","status":"FINISHED","focus":false},{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=105"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753345899293_1486135774","id":"paragraph_1753345899293_1486135774","dateCreated":"2025-07-24T08:31:39+0000","status":"FINISHED","text":"// Distribución de Área de Residencia de Madres No Residentes (con filtrado de datos no deseados)\r\n    z.show(\r\n        dfNacidosCleanFinal\r\n            .filter(col(\"residente\").isNotNull && col(\"residente\") =!= \"Sin información\" && col(\"residente\") =!= \"\" && col(\"residente\") === \"No Residente\" &&\r\n                    col(\"area_res\").isNotNull && col(\"area_res\") =!= \"Sin información\" && col(\"area_res\") =!= \"\")\r\n            .