s":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfValidos\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_insc: string, cant_insc: string ... 48 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753260896813_1978725459","id":"paragraph_1753260896813_1978725459","dateCreated":"2025-07-23T08:54:56+0000","dateStarted":"2025-07-23T08:55:03+0000","dateFinished":"2025-07-23T08:55:03+0000","status":"FINISHED"},{"text":"val dfTotalPorProvincia = dfValidos\r\n  .groupBy(\"prov_nac\")\r\n  .count()\r\n  .withColumnRenamed(\"count\", \"total_nacimientos\")","user":"anonymous","dateUpdated":"2025-07-23T08:57:30+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfTotalPorProvincia\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_nac: string, total_nacimientos: bigint]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753260905897_60606773","id":"paragraph_1753260905897_60606773","dateCreated":"2025-07-23T08:55:05+0000","dateStarted":"2025-07-23T08:57:30+0000","dateFinished":"2025-07-23T08:57:31+0000","status":"FINISHED"},{"text":"val dfPrematurosPorProvincia = dfValidos\r\n  .filter(col(\"sem_gest\") < 37)\r\n  .groupBy(\"prov_nac\")\r\n  .count()\r\n  .withColumnRenamed(\"count\", \"prematuros\")","user":"anonymous","dateUpdated":"2025-07-23T08:57:40+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfPrematurosPorProvincia\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_nac: string, prematuros: bigint]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753261057638_238595009","id":"paragraph_1753261057638_238595009","dateCreated":"2025-07-23T08:57:37+0000","dateStarted":"2025-07-23T08:57:40+0000","dateFinished":"2025-07-23T08:57:40+0000","status":"FINISHED"},{"text":"val dfProporcionPrematuros = dfTotalPorProvincia\r\n  .join(dfPrematurosPorProvincia, Seq(\"prov_nac\"), \"left\")\r\n  .na.fill(0, Seq(\"prematuros\"))\r\n  .withColumn(\"proporcion_prematuros\", col(\"prematuros\") / col(\"total_nacimientos\"))\r\n  .orderBy(desc(\"proporcion_prematuros\"))","user":"anonymous","dateUpdated":"2025-07-23T08:57:50+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfProporcionPrematuros\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_nac: string, total_nacimientos: bigint ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753261067470_2079964798","id":"paragraph_1753261067470_2079964798","dateCreated":"2025-07-23T08:57:47+0000","dateStarted":"2025-07-23T08:57:50+0000","dateFinished":"2025-07-23T08:57:50+0000","status":"FINISHED"},{"text":"z.show(dfProporcionPrematuros)\r\n","user":"anonymous","dateUpdated":"2025-07-24T08:38:23+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"prov_nac","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"total_nacimientos","index":