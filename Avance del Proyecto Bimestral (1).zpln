4T08:24:49+0000","dateFinished":"2025-07-24T08:24:53+0000","status":"FINISHED"},{"text":"%pyspark\n\nplt.figure(figsize = (20, 10))\nplt.boxplot(df_nacidos_anio_nac['apgar1'],showfliers=True)\nplt.title('Boxplot de apgar1 para Deteccion de Outliers')\nplt.ylabel('apgar1')\nplt.grid(True, linestyle='--', alpha = 0.7)\nplt.show()","user":"anonymous","dateUpdated":"2025-07-24T08:24:53+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752765884330_2091273298","id":"paragraph_1752765884330_2091273298","dateCreated":"2025-07-17T15:24:44+0000","dateStarted":"2025-07-24T08:24:53+0000","dateFinished":"2025-07-24T08:24:53+0000","status":"FINISHED"},{"text":"val stats = dfNacidosCleanFinal\n    .select(\n        avg(\"peso\").as(\"media\"),\n        stddev(\"peso\").as(\"desviacion_estandar\")\n    ).first","user":"anonymous","dateUpdated":"2025-07-24T08:24:53+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m = [3068.7153236346126,505.60786527826025]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=83"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=84"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752767858760_412452716","id":"paragraph_1752767858760_412452716","dateCreated":"2025-07-17T15:57:38+0000","dateStarted":"2025-07-24T08:24:53+0000","dateFinished":"2025-07-24T08:24:55+0000","status":"FINISHED"},{"text":"\nval media = stats.getAs[Double](\"media\")\nval desStand = stats.getAs[Double](\"desviacion_estandar\")\nval umbralDesviacion = 2.0","user":"anonymous","dateUpdated":"2025-07-24T08:24:55+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 3068.7153236346126\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 505.60786527826025\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2.0\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752767863148_1071348244","id":"paragraph_1752767863148_1071348244","dateCreated":"2025-07-17T15:57:43+0000","dateStarted":"2025-07-24T08:24:55+0000","dateFinished":"2025-07-24T08:24:55+0000","status":"FINISHED"},{"text":"val limiteInfDS = media - umbralDesviacion * desStand\r\nval limiteSupDS = media + umbralDesviacion * desStand","user":"anonymous","dateUpdated":"2025-07-24T08:24:55+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mlimiteInfDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2057.499593078092\n\u001b[1m\u001b[34mlimiteSupDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 4079.931054191133\n"}]},"apps":[],"runtimeInfos":{},"progres